{
  "name": "palate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc -p tsconfig.test.json && node --test work/test-build/tests/*.test.js tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.344.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.6.3",
    "vite": "8.3.4"
  }
}
